<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no"/>
<title>WorkFlow</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<style>
/* ── TOKENS ── */
:root {
  --bg:      #111318;
  --bg2:     #1a1d24;
  --bg3:     #22262f;
  --line:    rgba(255,255,255,.07);
  --t1:      #e8eaf0;
  --t2:      #6b7280;
  --t3:      #3a3f4a;
  --accent:  #4f7fff;

  --cD: #4f7fff;
  --cN: #8b6fd4;
  --cO: #d4933a;
  --cV: #3aad7a;
  --cX: #d44f4f;

  --nav: 60px;
  --r:   14px;
  --pad: 16px;
}
.light {
  --bg:   #f4f6fb;
  --bg2:  #ffffff;
  --bg3:  #edf0f7;
  --line: rgba(0,0,0,.07);
  --t1:   #111318;
  --t2:   #6b7280;
  --t3:   #c0c4cf;
  --accent: #3b6fe8;
}

/* ── RESET ── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{background:var(--bg);color:var(--t1);font-family:'Inter',system-ui,sans-serif;overscroll-behavior:none}
body{padding-bottom:var(--nav)}
input,select,textarea,button{font-family:inherit}
::-webkit-scrollbar{width:0;height:0}

/* ── NAV ── */
.nav{
  position:fixed;bottom:0;left:0;right:0;
  height:var(--nav);background:var(--bg2);
  border-top:1px solid var(--line);
  display:flex;z-index:100;
  padding-bottom:env(safe-area-inset-bottom,0);
}
.nb{
  flex:1;display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  gap:3px;background:none;border:none;
  color:var(--t3);font-size:9px;font-weight:600;
  letter-spacing:.3px;cursor:pointer;
  transition:color .15s;
}
.nb .i{font-size:19px;transition:transform .15s}
.nb.on{color:var(--accent)}
.nb.on .i{transform:scale(1.1)}

/* ── PAGES ── */
.pg{display:none;padding:var(--pad);animation:fadeUp .18s ease}
.pg.on{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}

/* ── TYPOGRAPHY ── */
.label{font-size:10px;font-weight:700;color:var(--t2);letter-spacing:.6px;text-transform:uppercase;margin-bottom:8px}
.h2{font-size:20px;font-weight:800;line-height:1.1}

/* ── CARD ── */
.card{background:var(--bg2);border:1px solid var(--line);border-radius:var(--r);padding:16px;margin-bottom:10px}
.card-sm{padding:12px}
.tap{transition:opacity .1s;cursor:pointer}
.tap:active{opacity:.7}

/* ── SHIFT HERO ── */
.hero{
  border-radius:18px;padding:22px 20px;
  margin-bottom:14px;
  position:relative;overflow:hidden;
}
.hero-bg{
  position:absolute;inset:0;
  opacity:.12;border-radius:inherit;
}
.hero>*{position:relative}
.hero-label{font-size:11px;font-weight:600;color:rgba(255,255,255,.55);margin-bottom:12px}
.hero-row{display:flex;align-items:flex-end;justify-content:space-between;gap:8px}
.hero-left .emoji{font-size:44px;line-height:1;margin-bottom:8px}
.hero-left .name{font-size:28px;font-weight:800;color:#fff;letter-spacing:-.3px;line-height:1}
.hero-left .hours{font-size:13px;color:rgba(255,255,255,.6);margin-top:4px}
.hero-right{text-align:right;padding-bottom:4px}
.hero-right .date-num{font-size:36px;font-weight:800;color:rgba(255,255,255,.9);line-height:1}
.hero-right .date-str{font-size:11px;color:rgba(255,255,255,.45);margin-top:2px}

/* ── UPCOMING ── */
.up-row{display:flex;gap:8px;margin-bottom:14px}
.up-card{
  flex:1;border-radius:var(--r);padding:14px 12px;
  position:relative;overflow:hidden;
}
.up-card .uc-day{font-size:10px;font-weight:600;color:rgba(255,255,255,.55);margin-bottom:6px}
.up-card .uc-ico{font-size:22px;line-height:1;margin-bottom:6px}
.up-card .uc-name{font-size:14px;font-weight:700;color:#fff}
.up-card .uc-time{font-size:10px;color:rgba(255,255,255,.5);margin-top:2px}

/* ── SHIFT COLORS ── */
.sD{background:var(--cD)}.sN{background:var(--cN)}.sO{background:var(--cO)}.sV{background:var(--cV)}.sX{background:var(--cX)}
.sDl{background:color-mix(in srgb,var(--cD) 12%,var(--bg2))}.sNl{background:color-mix(in srgb,var(--cN) 12%,var(--bg2))}
.sOl{background:color-mix(in srgb,var(--cO) 12%,var(--bg2))}.sVl{background:color-mix(in srgb,var(--cV) 12%,var(--bg2))}
.sXl{background:color-mix(in srgb,var(--cX) 12%,var(--bg2))}
.dot-D{color:var(--cD)}.dot-N{color:var(--cN)}.dot-O{color:var(--cO)}.dot-V{color:var(--cV)}.dot-X{color:var(--cX)}

/* ── CALENDAR ── */
.cal-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.cal-nav h2{font-size:18px;font-weight:800}
.cal-btn{
  width:32px;height:32px;border-radius:50%;
  background:var(--bg3);border:none;color:var(--t1);
  font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;
  transition:opacity .1s;
}
.cal-btn:active{opacity:.6}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.dow{text-align:center;font-size:9.5px;font-weight:700;color:var(--t3);padding:0 0 6px}
.cc{
  aspect-ratio:1;border-radius:9px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  cursor:pointer;background:var(--bg3);
  transition:opacity .1s;position:relative;
}
.cc:active{opacity:.65}
.cc.dim{opacity:.18;pointer-events:none}
.cc .n{font-size:13px;font-weight:700;line-height:1}
.cc .s{font-size:8px;font-weight:800;margin-top:1.5px;opacity:.85}
/* coloured cells */
.cc.hD{background:color-mix(in srgb,var(--cD) 20%,var(--bg3));}.cc.hD .n,.cc.hD .s{color:var(--cD)}
.cc.hN{background:color-mix(in srgb,var(--cN) 20%,var(--bg3));}.cc.hN .n,.cc.hN .s{color:var(--cN)}
.cc.hO{background:color-mix(in srgb,var(--cO) 20%,var(--bg3));}.cc.hO .n,.cc.hO .s{color:var(--cO)}
.cc.hV{background:color-mix(in srgb,var(--cV) 20%,var(--bg3));}.cc.hV .n,.cc.hV .s{color:var(--cV)}
.cc.hX{background:color-mix(in srgb,var(--cX) 20%,var(--bg3));}.cc.hX .n,.cc.hX .s{color:var(--cX)}
.cc.today{outline:2px solid var(--accent);outline-offset:-1px}
.cc.note::after{content:'';position:absolute;top:3px;right:3px;width:4px;height:4px;border-radius:50%;background:var(--accent)}

/* ── STAT ROW ── */
.stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
.sc{background:var(--bg2);border:1px solid var(--line);border-radius:var(--r);padding:12px 10px;text-align:center}
.sc .n{font-size:22px;font-weight:800;line-height:1}
.sc .l{font-size:9.5px;color:var(--t2);margin-top:3px;font-weight:500}

/* ── STATS PAGE ── */
.big-stat{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.bs{background:var(--bg2);border:1px solid var(--line);border-radius:var(--r);padding:16px}
.bs .ico{font-size:18px;margin-bottom:8px}
.bs .num{font-size:26px;font-weight:900;line-height:1}
.bs .lbl{font-size:11px;color:var(--t2);margin-top:4px}
.chart-box{position:relative;width:180px;margin:0 auto 14px}
.chart-mid{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;pointer-events:none}
.chart-mid .cn{font-size:20px;font-weight:900}
.chart-mid .cl{font-size:9px;color:var(--t2);margin-top:1px}
.leg{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
.li{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--t2)}
.ld{width:8px;height:8px;border-radius:2px}
.bar-wrap{position:relative;height:140px}
.sbar{display:flex;align-items:center;gap:8px;margin-bottom:7px}
.sbar-label{font-size:11px;font-weight:600;min-width:62px;color:var(--t1)}
.sbar-track{flex:1;background:var(--bg3);border-radius:100px;height:7px;overflow:hidden}
.sbar-fill{height:100%;border-radius:100px;transition:width .4s ease}
.sbar-num{font-size:11px;font-weight:700;color:var(--t2);min-width:16px;text-align:right}
.hist-row{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid var(--line)}
.hist-row:last-child{border-bottom:none}
.hist-name{font-size:13px;font-weight:600}
.hist-sub{font-size:11px;color:var(--t2);margin-top:2px}
.chip{display:inline-block;padding:2px 8px;border-radius:100px;font-size:10px;font-weight:700;color:#fff}

/* ── EXPENSES ── */
.bal-card{
  border-radius:18px;padding:22px 20px;margin-bottom:12px;
  background:linear-gradient(135deg,#1a2545,#1e3a8a);
  position:relative;overflow:hidden;
}
.bal-card::after{content:'💳';position:absolute;right:-4px;bottom:-12px;font-size:72px;opacity:.07}
.bal-card .bl{font-size:10px;font-weight:600;color:rgba(255,255,255,.5);margin-bottom:6px}
.bal-card .bn{font-size:36px;font-weight:900;color:#fff;line-height:1}
.bal-card .brow{display:flex;gap:20px;margin-top:14px}
.bal-card .bi .bil{font-size:10px;color:rgba(255,255,255,.45)}
.bal-card .bi .biv{font-size:13px;font-weight:700;color:rgba(255,255,255,.85)}
.ptrack{background:rgba(255,255,255,.12);border-radius:100px;height:4px;margin-top:14px;overflow:hidden}
.pfill{height:100%;border-radius:100px;background:rgba(255,255,255,.7);transition:width .4s ease}
.exp-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}
.exp-item:last-child{border-bottom:none}
.eico{width:36px;height:36px;border-radius:9px;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
.einfo{flex:1;min-width:0}
.edesc{font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.emeta{font-size:10.5px;color:var(--t2);margin-top:1px}
.eamt{font-size:14px;font-weight:800;color:var(--cX);flex-shrink:0}
.edel{background:none;border:none;font-size:17px;color:var(--t3);cursor:pointer;padding:3px}
.goal-bar{background:var(--bg3);border-radius:100px;height:5px;overflow:hidden;margin-top:10px}
.goal-fill{height:100%;border-radius:100px;background:var(--cV);transition:width .4s ease}

/* ── INPUTS ── */
.inp{width:100%;padding:11px 13px;background:var(--bg3);color:var(--t1);border:1.5px solid var(--line);border-radius:10px;font-size:15px;outline:none;transition:border-color .15s;-webkit-appearance:none}
.inp:focus{border-color:var(--accent)}
.il{display:block;font-size:11px;font-weight:600;color:var(--t2);margin-bottom:4px}
.ig{margin-bottom:9px}
.row{display:flex;gap:8px}.row>.ig{flex:1}
textarea.inp{resize:none}

/* ── BUTTONS ── */
.btn{background:var(--accent);color:#fff;border:none;border-radius:10px;padding:12px 18px;font-size:14px;font-weight:700;cursor:pointer;width:100%;transition:opacity .15s,transform .1s}
.btn:active{opacity:.8;transform:scale(.98)}
.btn-g{background:var(--bg3);color:var(--t1);border:1px solid var(--line);border-radius:10px;padding:10px 14px;font-size:13px;font-weight:600;cursor:pointer;transition:opacity .15s}
.btn-g:active{opacity:.7}
.btn-sm{padding:9px 14px;font-size:13px;width:auto}
.btn-red{background:color-mix(in srgb,var(--cX) 15%,var(--bg3));color:var(--cX)}

/* ── PHASE GRID ── */
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}
.pbtn{border:2px solid transparent;border-radius:9px;padding:9px 2px;text-align:center;font-size:11px;font-weight:800;cursor:pointer;color:#fff;font-family:inherit;transition:transform .1s}
.pbtn:active{transform:scale(.92)}
.pbtn.on{border-color:var(--t1);box-shadow:0 0 0 1px var(--bg)}

/* ── ROUTINE ── */
.rt-item{display:flex;align-items:center;gap:9px;padding:9px 0;border-bottom:1px solid var(--line)}
.rt-item:last-child{border-bottom:none}
.rt-time{font-size:12px;font-weight:800;color:var(--accent);min-width:40px}
.rt-title{flex:1;font-size:13px}
.rt-del{background:none;border:none;font-size:16px;color:var(--t3);cursor:pointer}

/* ── TABS ── */
.tabs{display:flex;gap:5px;overflow-x:auto;padding-bottom:2px;margin-bottom:10px;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{flex:0 0 auto;padding:6px 12px;border-radius:100px;border:1.5px solid var(--line);font-size:12px;font-weight:700;cursor:pointer;background:none;color:var(--t2);transition:all .15s}
.tab.on{background:var(--accent);border-color:var(--accent);color:#fff}

/* ── MODAL ── */
.ov{position:fixed;inset:0;background:rgba(0,0,0,.55);backdrop-filter:blur(3px);z-index:200;display:flex;align-items:flex-end;animation:fo .15s}
.ov.h{display:none}
@keyframes fo{from{opacity:0}to{opacity:1}}
.modal{background:var(--bg2);border-radius:18px 18px 0 0;border-top:1px solid var(--line);padding:20px;width:100%;max-height:88vh;overflow-y:auto;animation:su .2s cubic-bezier(.4,0,.2,1);padding-bottom:max(20px,env(safe-area-inset-bottom,20px))}
@keyframes su{from{transform:translateY(30px);opacity:0}to{transform:none;opacity:1}}
.drag{width:32px;height:3.5px;border-radius:2px;background:var(--line);margin:0 auto 16px}
.sopt{display:flex;align-items:center;gap:11px;padding:11px 13px;border-radius:10px;cursor:pointer;margin-bottom:5px;border:1.5px solid transparent;background:var(--bg3);transition:border-color .15s}
.sopt.on{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 8%,var(--bg3))}
.sopt:active{opacity:.7}
.sopt .soi{font-size:22px;width:38px;height:38px;border-radius:9px;display:flex;align-items:center;justify-content:center}
.sopt .son{font-size:14px;font-weight:700}
.sopt .soh{font-size:11px;color:var(--t2);margin-top:1px}
.note-prev{background:var(--bg3);border-radius:9px;padding:10px;font-size:12px;color:var(--t2);min-height:32px;white-space:pre-wrap}
.div{height:1px;background:var(--line);margin:12px 0}

/* ── TOAST ── */
.toast{position:fixed;bottom:calc(var(--nav) + 12px);left:50%;transform:translateX(-50%);background:var(--t1);color:var(--bg);padding:9px 18px;border-radius:100px;font-size:13px;font-weight:600;z-index:400;white-space:nowrap;box-shadow:0 4px 20px rgba(0,0,0,.3);animation:ti .17s ease}
@keyframes ti{from{opacity:0;transform:translateX(-50%) translateY(6px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}

/* ── UTILS ── */
.f{display:flex}.ac{align-items:center}.jb{justify-content:space-between}
.mt4{margin-top:4px}.mt8{margin-top:8px}.mt12{margin-top:12px}.mt16{margin-top:16px}
.mb4{margin-bottom:4px}.mb8{margin-bottom:8px}
.sm{font-size:12px}.xs{font-size:10.5px}
.c2{color:var(--t2)}.fw8{font-weight:800}
.sec{margin-top:16px;margin-bottom:8px}
.h{display:none!important}
.wf{width:100%}
.tc{text-align:center}
</style>
</head>
<body>

<!-- HOME -->
<div id="pg-home" class="pg on">
  <div id="hero" class="hero sD">
    <div class="hero-bg sD"></div>
    <div class="hero-label" id="h-label">Сегодня</div>
    <div class="hero-row">
      <div class="hero-left">
        <div class="emoji" id="h-emoji">🌅</div>
        <div class="name" id="h-name">—</div>
        <div class="hours" id="h-hours">—</div>
      </div>
      <div class="hero-right">
        <div class="date-num" id="h-dnum">—</div>
        <div class="date-str" id="h-dstr">—</div>
      </div>
    </div>
  </div>

  <div class="label">Ближайшие смены</div>
  <div class="up-row" id="upcoming"></div>

  <div class="label sec">Распорядок сегодня</div>
  <div class="card card-sm" id="home-rt"></div>

  <div class="label sec">Быстрый расход</div>
  <div class="card">
    <div class="ig"><label class="il">Сумма, ₽</label><input type="number" id="qa" class="inp" placeholder="0" inputmode="decimal"/></div>
    <div class="row">
      <div class="ig"><label class="il">Категория</label><select id="qc" class="inp"></select></div>
      <div class="ig"><label class="il">Описание</label><input type="text" id="qd" class="inp" placeholder="Кофе…"/></div>
    </div>
    <button class="btn btn-sm" onclick="qExp()">+ Добавить</button>
  </div>
</div>

<!-- CALENDAR -->
<div id="pg-cal" class="pg">
  <div class="cal-nav">
    <button class="cal-btn" onclick="sm(-1)">‹</button>
    <h2 id="cal-title">—</h2>
    <button class="cal-btn" onclick="sm(1)">›</button>
  </div>
  <div id="cal-grid" class="cal-grid"></div>

  <div class="label sec">Месяц</div>
  <div class="card card-sm" id="cal-stats"></div>
</div>

<!-- STATS -->
<div id="pg-stats" class="pg">
  <div class="f ac jb mb8">
    <div style="font-size:20px;font-weight:800">Статистика</div>
    <select id="st-sel" class="inp" style="width:auto;padding:6px 10px;font-size:12px"></select>
  </div>

  <div class="big-stat" id="st-nums"></div>

  <div class="label">Распределение</div>
  <div class="card">
    <div class="chart-box">
      <canvas id="pie" width="180" height="180"></canvas>
      <div class="chart-mid">
        <div class="cn" id="pie-n">—</div>
        <div class="cl">смен</div>
      </div>
    </div>
    <div class="leg" id="pie-leg"></div>
    <div style="height:14px"></div>
    <div id="sbars"></div>
  </div>

  <div class="label sec">Последние 6 месяцев</div>
  <div class="card">
    <div class="bar-wrap"><canvas id="barchart"></canvas></div>
    <div class="leg mt8" id="bar-leg"></div>
  </div>

  <div class="label sec">История</div>
  <div class="card card-sm" id="hist"></div>
</div>

<!-- EXPENSES -->
<div id="pg-exp" class="pg">
  <div class="bal-card">
    <div class="bl">ОСТАТОК</div>
    <div class="bn" id="bn">0 ₽</div>
    <div class="ptrack"><div class="pfill" id="pf" style="width:100%"></div></div>
    <div class="brow">
      <div class="bi"><div class="bil">Зарплата</div><div class="biv" id="bsal">0 ₽</div></div>
      <div class="bi"><div class="bil">Потрачено</div><div class="biv" id="bsp">0 ₽</div></div>
      <div class="bi" style="margin-left:auto;padding-top:4px">
        <button class="btn-g btn-sm" onclick="showSal()" style="background:rgba(255,255,255,.1);color:#fff;border-color:rgba(255,255,255,.15)">✏️ Зп</button>
      </div>
    </div>
  </div>

  <div id="echcard" class="card h">
    <div class="label">По категориям</div>
    <div class="chart-box">
      <canvas id="ech" width="180" height="180"></canvas>
      <div class="chart-mid">
        <div class="cn" id="epct">0%</div>
        <div class="cl">бюджета</div>
      </div>
    </div>
    <div class="leg" id="eleg"></div>
  </div>

  <div class="label sec">Добавить расход</div>
  <div class="card">
    <div class="ig"><label class="il">Сумма, ₽</label><input type="number" id="ea" class="inp" placeholder="0" inputmode="decimal"/></div>
    <div class="row">
      <div class="ig"><label class="il">Категория</label><select id="ec" class="inp"></select></div>
      <div class="ig"><label class="il">Дата</label><input type="date" id="ed" class="inp"/></div>
    </div>
    <div class="ig"><label class="il">Описание</label><input type="text" id="edesc" class="inp" placeholder=""/></div>
    <button class="btn" onclick="addExp()">Добавить</button>
  </div>

  <div id="elw" class="h">
    <div class="label sec">История</div>
    <div class="card card-sm" id="elist"></div>
