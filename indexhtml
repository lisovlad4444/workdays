    <div class="f" style="gap:8px;margin-top:10px">
      <button class="btn-g" style="flex:1" onclick="closeSal()">Отмена</button>
      <button class="btn" style="flex:2" onclick="saveSal()">Сохранить</button>
    </div>
  </div>
</div>

<script>
// ═══════════ TG ═══════════
const tg=window.Telegram?.WebApp;
if(tg){tg.ready();tg.expand();tg.enableClosingConfirmation();if(tg.colorScheme!=='dark')document.documentElement.classList.add('light');}

// ═══════════ CONSTANTS ═══════════
const CYC=['D','N','O','V'];
const SH={
  D:{id:'D',name:'День',     ico:'🌅',c:'#4f7fff',hd:'8:00 – 20:00', s:'Д'},
  N:{id:'N',name:'Ночь',     ico:'🌙',c:'#8b6fd4',hd:'20:00 – 8:00', s:'Н'},
  O:{id:'O',name:'Отсыпной', ico:'😴',c:'#d4933a',hd:'Отдых дома',   s:'О'},
  V:{id:'V',name:'Выходной', ico:'🌿',c:'#3aad7a',hd:'Свободный день',s:'В'},
  X:{id:'X',name:'Доп. смена',ico:'⚡',c:'#d44f4f',hd:'Внеплановая',  s:'Д+'},
};
function shHours(id){const t=S.times?.[id];if(!t)return SH[id].hd;if(t.s&&t.e)return`${t.s} – ${t.e}`;if(t.s)return`с ${t.s}`;return SH[id].hd;}
const CATS={
  food:          {ico:'🍕',lbl:'Еда',          c:'#ef4444'},
  transport:     {ico:'🚗',lbl:'Транспорт',    c:'#f59e0b'},
  health:        {ico:'💊',lbl:'Здоровье',     c:'#10b981'},
  entertainment: {ico:'🎮',lbl:'Развлечения',  c:'#8b5cf6'},
  shopping:      {ico:'🛍️',lbl:'Покупки',      c:'#3b82f6'},
  other:         {ico:'📦',lbl:'Прочее',       c:'#6b7280'},
};
const MN=['Январь','Февраль','Март','Апрель','Май','Июнь','Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'];
const MG=['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
const DOW=['Пн','Вт','Ср','Чт','Пт','Сб','Вс'];
const WDAYS=['воскресенье','понедельник','вторник','среда','четверг','пятница','суббота'];

// ═══════════ STATE ═══════════
function def(){const t=iso(new Date());return{name:tg?.initDataUnsafe?.user?.first_name||'',rate:0,sc:{sd:t,sp:0,ov:{},nt:'08:00'},ex:{sal:0,items:[]},rt:{D:[],N:[],O:[],V:[],X:[]},notes:{},goal:null,times:{D:{s:'08:00',e:'20:00'},N:{s:'20:00',e:'08:00'},O:{s:'',e:''},V:{s:'',e:''},X:{s:'08:00',e:'20:00'}}};}
let S=load();
function load(){try{const r=localStorage.getItem('wf4');if(r)return Object.assign(def(),JSON.parse(r));}catch{}return def();}
function save(){try{localStorage.setItem('wf4',JSON.stringify(S));}catch{}}

let calY,calM,curRT='D',dmDate=null,dmSh=null;
{const n=new Date();calY=n.getFullYear();calM=n.getMonth();}
let pieC=null,expC=null,barC=null;

// ═══════════ DATE ═══════════
function iso(d){return`${d.getFullYear()}-${p2(d.getMonth()+1)}-${p2(d.getDate())}`;}
function p2(n){return String(n).padStart(2,'0');}
function pd(s){const[y,m,d]=s.split('-').map(Number);return new Date(y,m-1,d);}
function ad(d,n){const r=new Date(d);r.setDate(r.getDate()+n);return r;}
function flong(ds){const d=pd(ds);return`${d.getDate()} ${MG[d.getMonth()]}, ${WDAYS[d.getDay()]}`;}
function fshort(ds){const d=pd(ds);return`${d.getDate()} ${MG[d.getMonth()].slice(0,3)}.`;}
function fm(n){return new Intl.NumberFormat('ru-RU',{style:'currency',currency:'RUB',maximumFractionDigits:0}).format(n);}
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

// ═══════════ SCHEDULE ═══════════
function gs(ds){
  if(S.sc.ov[ds])return S.sc.ov[ds];
  const d=Math.round((pd(ds)-pd(S.sc.sd))/86400000);
  return CYC[((S.sc.sp+d)%4+4)%4];
}
function mst(y,m){
  const days=new Date(y,m+1,0).getDate();
  const c={D:0,N:0,O:0,V:0,X:0};
  for(let d=1;d<=days;d++)c[gs(`${y}-${p2(m+1)}-${p2(d)}`)]++;
  const w=c.D+c.N+c.X;
  return{c,w,h:w*12,days};
}

// ═══════════ POPULATE SELECTS ═══════════
function fillCats(){
  const o=Object.entries(CATS).map(([k,v])=>`<option value="${k}">${v.ico} ${v.lbl}</option>`).join('');
  ['qc','ec'].forEach(id=>{const e=document.getElementById(id);if(e)e.innerHTML=o;});
}

// ═══════════ NAV ═══════════
function go(name,btn){
  document.querySelectorAll('.pg').forEach(p=>p.classList.remove('on'));
  document.querySelectorAll('.nb').forEach(b=>b.classList.remove('on'));
  document.getElementById('pg-'+name).classList.add('on');
  btn.classList.add('on');
  try{tg?.HapticFeedback?.selectionChanged();}catch{}
  if(name==='home') rHome();
  if(name==='cal')  rCal();
  if(name==='stats') rStats();
  if(name==='exp')  rExp();
  if(name==='set')  rSet();
}

// ═══════════ HOME ═══════════
function rHome(){
  const today=iso(new Date());
  const sid=gs(today),sh=SH[sid],d=pd(today);
  // hero
  document.getElementById('hero').className=`hero s${sid}`;
  document.getElementById('hero').querySelector('.hero-bg').className=`hero-bg s${sid}`;
  document.getElementById('h-label').textContent=`${S.name?'Привет, '+S.name+'! ':''} Сегодня:`;
  document.getElementById('h-emoji').textContent=sh.ico;
  document.getElementById('h-name').textContent=sh.name;
  document.getElementById('h-hours').textContent=shHours(sid);
  document.getElementById('h-dnum').textContent=d.getDate();
  document.getElementById('h-dstr').textContent=MN[d.getMonth()].slice(0,3)+' '+d.getFullYear();

  // upcoming
  const up=document.getElementById('upcoming');
  up.innerHTML='';
  [[1,'Завтра'],[2,'Послезавтра']].forEach(([off,lbl])=>{
    const ds=iso(ad(new Date(),off)),s=SH[gs(ds)];
    const c=document.createElement('div');
    c.className=`up-card s${s.id}`;
    c.innerHTML=`<div class="uc-day">${lbl}</div><div class="uc-ico">${s.ico}</div><div class="uc-name">${s.name}</div><div class="uc-time">${shHours(s.id)}</div>`;
    up.appendChild(c);
  });

  // routine
  const items=(S.rt[sid]||[]).sort((a,b)=>a.t.localeCompare(b.t));
  const note=S.notes[today]||'';
  const rt=document.getElementById('home-rt');
  let h='';
  if(note)h+=`<div style="font-size:12px;color:var(--t2);background:var(--bg3);border-radius:8px;padding:8px;margin-bottom:8px">📝 ${esc(note)}</div>`;
  if(!items.length&&!note)h+=`<p class="sm c2">Нет распорядка для «${sh.name}». Добавьте в Настройках.</p>`;
  else h+=items.map(it=>`<div class="rt-item"><span class="rt-time">${it.t}</span><span class="rt-title">${esc(it.title)}</span></div>`).join('');
  rt.innerHTML=h;
}

// ═══════════ CALENDAR ═══════════
function sm(d){calM+=d;if(calM>11){calM=0;calY++;}if(calM<0){calM=11;calY--;}rCal();}
function rCal(){
  document.getElementById('cal-title').textContent=`${MN[calM]} ${calY}`;
  const today=iso(new Date());
  const grid=document.getElementById('cal-grid');
  const dim=new Date(calY,calM+1,0).getDate();
  const fdow=(new Date(calY,calM,1).getDay()+6)%7;
  const prev=new Date(calY,calM,0).getDate();
  grid.innerHTML=DOW.map(d=>`<div class="dow">${d}</div>`).join('');
  const mk=(date,dm)=>{
    const ds=iso(date),sid=gs(ds);
    const el=document.createElement('div');
    el.className=`cc h${sid}${dm?' dim':''}${ds===today?' today':''}${S.notes[ds]?' note':''}`;
    el.innerHTML=`<span class="n">${date.getDate()}</span><span class="s">${SH[sid].s}</span>`;
    if(!dm)el.onclick=()=>openDay(ds);
    grid.appendChild(el);
  };
  for(let i=fdow-1;i>=0;i--)mk(new Date(calY,calM-1,prev-i),true);
  for(let d=1;d<=dim;d++)mk(new Date(calY,calM,d),false);
  const tr=(fdow+dim)%7===0?0:7-(fdow+dim)%7;
  for(let d=1;d<=tr;d++)mk(new Date(calY,calM+1,d),true);
  // stats
  const st=mst(calY,calM);
  document.getElementById('cal-stats').innerHTML=`
    <div class="f jb" style="margin-bottom:8px"><span class="sm c2">Рабочих смен</span><span class="fw8">${st.w}</span></div>
    <div class="f jb" style="margin-bottom:8px"><span class="sm c2">Часов работы</span><span class="fw8">${st.h} ч</span></div>
    <div class="f jb" style="margin-bottom:${S.rate>0?'8px':'0'}"><span class="sm c2">Выходных + Отсып</span><span class="fw8">${st.c.V+st.c.O}</span></div>
    ${S.rate>0?`<div class="f jb"><span class="sm c2">Ожид. заработок</span><span class="fw8" style="color:var(--cV)">${fm(st.w*S.rate)}</span></div>`:''}
    <div class="f" style="gap:4px;margin-top:10px;height:5px;border-radius:100px;overflow:hidden">
      ${Object.values(SH).map(s=>`<div style="flex:${st.c[s.id]};background:${s.c};border-radius:100px"></div>`).join('')}
    </div>
    <div class="leg" style="margin-top:8px">
      ${Object.values(SH).map(s=>`<div class="li"><div class="ld" style="background:${s.c}"></div>${s.ico} ${st.c[s.id]}</div>`).join('')}
    </div>`;
}

// ═══════════ STATS ═══════════
function rStats(){
  const sel=document.getElementById('st-sel');
  if(!sel.options.length){
    const n=new Date();
    for(let i=0;i<12;i++){const d=new Date(n.getFullYear(),n.getMonth()-i,1);const o=document.createElement('option');o.value=`${d.getFullYear()}-${d.getMonth()}`;o.textContent=`${MN[d.getMonth()]} ${d.getFullYear()}`;sel.appendChild(o);}
    sel.onchange=rStatsPart;
  }
  rStatsPart();rBar();
}
function rStatsPart(){
  const[y,m]=(document.getElementById('st-sel').value||`${new Date().getFullYear()}-${new Date().getMonth()}`).split('-').map(Number);
  const st=mst(y,m);
  document.getElementById('st-nums').innerHTML=`
    <div class="bs"><div class="ico">🌅</div><div class="num" style="color:var(--cD)">${st.c.D}</div><div class="lbl">Дневных</div></div>
    <div class="bs"><div class="ico">🌙</div><div class="num" style="color:var(--cN)">${st.c.N}</div><div class="lbl">Ночных</div></div>
    <div class="bs"><div class="ico">⏱</div><div class="num">${st.h}</div><div class="lbl">Часов</div></div>
    <div class="bs"><div class="ico">🌿</div><div class="num" style="color:var(--cV)">${st.c.V}</div><div class="lbl">Выходных</div></div>`;
  document.getElementById('pie-n').textContent=st.w+st.c.O+st.c.V;
  const keys=Object.keys(st.c).filter(k=>st.c[k]>0);
  if(pieC)pieC.destroy();
  pieC=new Chart(document.getElementById('pie'),{type:'doughnut',data:{labels:keys.map(k=>SH[k].name),datasets:[{data:keys.map(k=>st.c[k]),backgroundColor:keys.map(k=>SH[k].c),borderWidth:0,hoverOffset:5}]},options:{cutout:'62%',responsive:false,plugins:{legend:{display:false}},animation:{duration:500}}});
  document.getElementById('pie-leg').innerHTML=keys.map(k=>`<div class="li"><div class="ld" style="background:${SH[k].c}"></div>${SH[k].ico} ${SH[k].name}: ${st.c[k]}</div>`).join('');
  document.getElementById('sbars').innerHTML=Object.values(SH).map(s=>`
    <div class="sbar">
      <span class="sbar-label">${s.ico} ${s.name}</span>
      <div class="sbar-track"><div class="sbar-fill" style="width:${st.days?st.c[s.id]/st.days*100:0}%;background:${s.c}"></div></div>
      <span class="sbar-num">${st.c[s.id]}</span>
    </div>`).join('');
  const n=new Date();
  document.getElementById('hist').innerHTML=Array.from({length:4},(_,i)=>{const d=new Date(n.getFullYear(),n.getMonth()-i,1);const hs=mst(d.getFullYear(),d.getMonth());return`<div class="hist-row"><div><div class="hist-name">${MN[d.getMonth()]} ${d.getFullYear()}</div><div class="hist-sub">${hs.h} ч · ${hs.c.V} вых.</div></div><div class="f" style="gap:4px;flex-wrap:wrap;justify-content:flex-end">${hs.c.D>0?`<span class="chip" style="background:var(--cD)">${hs.c.D}Д</span>`:''}${hs.c.N>0?`<span class="chip" style="background:var(--cN)">${hs.c.N}Н</span>`:''}${hs.c.X>0?`<span class="chip" style="background:var(--cX)">${hs.c.X}+</span>`:''}</div></div>`;}).join('');
}
function rBar(){
  const n=new Date(),L=[],D=[],N=[],V=[];
  for(let i=5;i>=0;i--){const d=new Date(n.getFullYear(),n.getMonth()-i,1);const st=mst(d.getFullYear(),d.getMonth());L.push(MN[d.getMonth()].slice(0,3));D.push(st.c.D);N.push(st.c.N);V.push(st.c.V+st.c.O);}
  if(barC)barC.destroy();
  const tc=getComputedStyle(document.documentElement).getPropertyValue('--t2').trim()||'#6b7280';
  const gc=getComputedStyle(document.documentElement).getPropertyValue('--line').trim()||'rgba(255,255,255,.07)';
  barC=new Chart(document.getElementById('barchart'),{type:'bar',data:{labels:L,datasets:[{label:'День',data:D,backgroundColor:'#4f7fff',borderRadius:4,barPercentage:.7},{label:'Ночь',data:N,backgroundColor:'#8b6fd4',borderRadius:4,barPercentage:.7},{label:'Отдых',data:V,backgroundColor:'#3aad7a',borderRadius:4,barPercentage:.7}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{mode:'index',intersect:false}},scales:{x:{ticks:{color:tc,font:{size:9}},grid:{display:false},border:{display:false}},y:{ticks:{color:tc,font:{size:9},maxTicksLimit:5},grid:{color:gc},border:{display:false}}},animation:{duration:500}}});
  document.getElementById('bar-leg').innerHTML=`<div class="li"><div class="ld" style="background:#4f7fff"></div>Дневные</div><div class="li"><div class="ld" style="background:#8b6fd4"></div>Ночные</div><div class="li"><div class="ld" style="background:#3aad7a"></div>Отдых</div>`;
}

// ═══════════ EXPENSES ═══════════
function rExp(){
  document.getElementById('ed').value=iso(new Date());
  const sal=S.ex.sal,items=S.ex.items;
  const spent=items.reduce((a,i)=>a+i.a,0),bal=sal-spent;
  const pct=sal>0?Math.min(100,Math.round((sal-spent)/sal*100)):100;
  const epct=sal>0?Math.min(100,Math.round(spent/sal*100)):0;
  document.getElementById('bn').textContent=fm(bal);
  document.getElementById('bn').style.color=bal<0?'#fca5a5':'#fff';
  document.getElementById('bsal').textContent=fm(sal);
  document.getElementById('bsp').textContent=fm(spent);
  document.getElementById('pf').style.width=pct+'%';
  document.getElementById('si').value=sal||'';
  if(items.length){
    document.getElementById('echcard').classList.remove('h');
    document.getElementById('epct').textContent=epct+'%';
    rExpChart(items);
    document.getElementById('elw').classList.remove('h');
    rExpList(items);
  }else{
    document.getElementById('echcard').classList.add('h');
    document.getElementById('elw').classList.add('h');
    if(expC){expC.destroy();expC=null;}
  }
  if(S.goal){
    document.getElementById('gw').classList.remove('h');
    const saved=Math.max(0,sal-spent),gp=S.goal.a>0?Math.min(100,Math.round(saved/S.goal.a*100)):0;
    document.getElementById('gc').innerHTML=`<div class="card card-sm"><div style="font-size:14px;font-weight:700;margin-bottom:8px">🎯 ${esc(S.goal.n)}</div><div class="f jb sm c2 mb4"><span>${fm(saved)} накоплено</span><span>${fm(S.goal.a)} цель</span></div><div class="goal-bar"><div class="goal-fill" style="width:${gp}%"></div></div><div class="xs c2 mt4">${gp}% от цели</div></div>`;
  }else{document.getElementById('gw').classList.add('h');}
}
function rExpChart(items){
  const tot={};items.forEach(i=>{tot[i.c]=(tot[i.c]||0)+i.a;});
  const keys=Object.keys(tot),data=keys.map(k=>tot[k]),colors=keys.map(k=>CATS[k]?.c||'#6b7280'),labels=keys.map(k=>CATS[k]?.lbl||k);
  if(expC)expC.destroy();
  expC=new Chart(document.getElementById('ech'),{type:'doughnut',data:{labels,datasets:[{data,backgroundColor:colors,borderWidth:0,hoverOffset:4}]},options:{cutout:'62%',responsive:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>` ${fm(c.raw)}`}}},animation:{duration:400}}});
  document.getElementById('eleg').innerHTML=keys.map((k,i)=>`<div class="li"><div class="ld" style="background:${colors[i]}"></div>${CATS[k]?.ico} ${labels[i]}: ${fm(data[i])}</div>`).join('');
}
function rExpList(items){
  const sorted=[...items].sort((a,b)=>b.dt.localeCompare(a.dt));
  document.getElementById('elist').innerHTML=sorted.map(it=>{const cat=CATS[it.c]||CATS.other;return`<div class="exp-item"><div class="eico">${cat.ico}</div><div class="einfo"><div class="edesc">${esc(it.d||cat.lbl)}</div><div class="emeta">${fshort(it.dt)} · ${cat.lbl}</div></div><span class="eamt">−${fm(it.a)}</span><button class="edel" onclick="delExp('${it.id}')">×</button></div>`;}).join('');
}
function addExp(){
  const a=parseFloat(document.getElementById('ea').value);
  if(!a||a<=0){toast('Введите сумму');return;}
  S.ex.items.push({id:Date.now().toString(),a,c:document.getElementById('ec').value,d:document.getElementById('edesc').value.trim(),dt:document.getElementById('ed').value||iso(new Date())});
  save();document.getElementById('ea').value='';document.getElementById('edesc').value='';
  try{tg?.HapticFeedback?.notificationOccurred('success');}catch{}
  rExp();toast('✅ Добавлено');
}
function qExp(){
  const a=parseFloat(document.getElementById('qa').value);
  if(!a||a<=0){toast('Введите сумму');return;}
  S.ex.items.push({id:Date.now().toString(),a,c:document.getElementById('qc').value,d:document.getElementById('qd').value.trim(),dt:iso(new Date())});
  save();document.getElementById('qa').value='';document.getElementById('qd').value='';
  try{tg?.HapticFeedback?.notificationOccurred('success');}catch{}
  toast('✅ Добавлено');
}
function delExp(id){S.ex.items=S.ex.items.filter(i=>i.id!==id);save();rExp();}
function showSal(){document.getElementById('si').value=S.ex.sal||'';document.getElementById('sal-ov').classList.remove('h');}
function closeSal(){document.getElementById('sal-ov').classList.add('h');}
function saveSal(){const v=parseFloat(document.getElementById('si').value);if(!isNaN(v)&&v>=0){S.ex.sal=v;save();}closeSal();rExp();toast('✅ Зарплата обновлена');}

// ═══════════ DAY MODAL ═══════════
function openDay(ds){
  dmDate=ds;dmSh=gs(ds);
  document.getElementById('dm-t').textContent='📅 '+flong(ds);
  document.getElementById('dm-opts').innerHTML=Object.values(SH).map(s=>`<div class="sopt${dmSh===s.id?' on':''}" onclick="pickSh('${s.id}',this)"><div class="soi s${s.id}">${s.ico}</div><div><div class="son">${s.name}</div><div class="soh">${shHours(s.id)}</div></div></div>`).join('');
  document.getElementById('dm-note').value=S.notes[ds]||'';
  rDmRt();
  document.getElementById('day-ov').classList.remove('h');
  try{tg?.HapticFeedback?.selectionChanged();}catch{}
}
function rDmRt(){
  const items=(S.rt[dmSh]||[]).sort((a,b)=>a.t.localeCompare(b.t));
  document.getElementById('dm-rt').innerHTML=items.length?items.map(it=>`<div class="rt-item"><span class="rt-time">${it.t}</span><span class="rt-title">${esc(it.title)}</span></div>`).join(''):'<p class="sm c2">Нет задач для этой смены</p>';
}
function pickSh(id,el){
  dmSh=id;
  document.querySelectorAll('.sopt').forEach(e=>e.classList.remove('on'));
  el.classList.add('on');
  rDmRt();
  try{tg?.HapticFeedback?.selectionChanged();}catch{}
}
function saveDay(){
  const auto=(()=>{const d=Math.round((pd(dmDate)-pd(S.sc.sd))/86400000);return CYC[((S.sc.sp+d)%4+4)%4];})();
  if(dmSh!==auto)S.sc.ov[dmDate]=dmSh;else delete S.sc.ov[dmDate];
  const note=document.getElementById('dm-note').value.trim();
  if(note)S.notes[dmDate]=note;else delete S.notes[dmDate];
  save();closeDay();rCal();
  try{tg?.HapticFeedback?.notificationOccurred('success');}catch{}
  toast('✅ Сохранено');
}
function closeDay(){document.getElementById('day-ov').classList.add('h');dmDate=null;}

// ═══════════ SETTINGS ═══════════
function rSet(){
  document.getElementById('sd').value=S.sc.sd;
  document.getElementById('sn').value=S.sc.nt;
  document.getElementById('sname').value=S.name||'';
  document.getElementById('srate').value=S.rate||'';
  if(S.goal){document.getElementById('gn').value=S.goal.n||'';document.getElementById('gamt').value=S.goal.a||'';}
  document.getElementById('pgrid').innerHTML=CYC.map((id,i)=>{const s=SH[id];return`<button class="pbtn${S.sc.sp===i?' on':''}" style="background:${s.c}" onclick="selP(${i})">${s.ico}<br>${s.name}</button>`;}).join('');
  document.getElementById('rtabs').innerHTML=Object.values(SH).map(s=>`<button class="tab${curRT===s.id?' on':''}" onclick="swRT('${s.id}')">${s.ico} ${s.name}</button>`).join('');
  rRCard();
  rTimesGrid();
}
function rTimesGrid(){
  if(!S.times)S.times={D:{s:'08:00',e:'20:00'},N:{s:'20:00',e:'08:00'},O:{s:'',e:''},V:{s:'',e:''},X:{s:'08:00',e:'20:00'}};
  document.getElementById('times-grid').innerHTML=Object.values(SH).map(sh=>`
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
      <span style="font-size:16px;width:24px">${sh.ico}</span>
      <span style="font-size:12px;font-weight:600;min-width:68px;color:var(--t1)">${sh.name}</span>
      <div style="flex:1;display:flex;gap:6px;align-items:center">
        <input type="time" id="ts-${sh.id}-s" class="inp" style="flex:1;padding:8px 10px;font-size:13px" value="${S.times[sh.id]?.s||''}" placeholder="начало"/>
        <span style="color:var(--t3);font-size:12px">—</span>
        <input type="time" id="ts-${sh.id}-e" class="inp" style="flex:1;padding:8px 10px;font-size:13px" value="${S.times[sh.id]?.e||''}" placeholder="конец"/>
      </div>
    </div>`).join('');
}
function saveTimesGrid(){
  if(!S.times)S.times={};
  Object.keys(SH).forEach(id=>{
    const s=document.getElementById(`ts-${id}-s`)?.value||'';
    const e=document.getElementById(`ts-${id}-e`)?.value||'';
    S.times[id]={s,e};
  });
}
function selP(i){S.sc.sp=i;rSet();}
function swRT(id){curRT=id;rSet();}
function rRCard(){
  const items=(S.rt[curRT]||[]).sort((a,b)=>a.t.localeCompare(b.t));
  document.getElementById('rcard').innerHTML=
    (items.length?items.map(it=>`<div class="rt-item"><span class="rt-time">${it.t}</span><span class="rt-title">${esc(it.title)}</span><button class="rt-del" onclick="delRT('${it.id}')">×</button></div>`).join('')+'<div class="div"></div>':'')
    +`<div class="f" style="gap:8px;margin-bottom:9px"><input type="time" id="rt-t" class="inp" value="09:00" style="flex:0 0 90px"/><input type="text" id="rt-tx" class="inp" placeholder="Задача…"/></div><button class="btn btn-sm" onclick="addRT()">+ Добавить</button>`;
}
function addRT(){
  const t=document.getElementById('rt-t').value,tx=document.getElementById('rt-tx').value.trim();
  if(!tx){toast('Введите задачу');return;}
  if(!S.rt[curRT])S.rt[curRT]=[];
  S.rt[curRT].push({id:Date.now().toString(),t,title:tx});
  save();rRCard();document.getElementById('rt-tx').value='';
}
function delRT(id){S.rt[curRT]=(S.rt[curRT]||[]).filter(i=>i.id!==id);save();rRCard();}
function saveGoal(){
  const n=document.getElementById('gn').value.trim(),a=parseFloat(document.getElementById('gamt').value);
  if(!n||!a){toast('Заполните цель');return;}
  S.goal={n,a};save();toast('🎯 Цель сохранена');
}
function saveSets(){
  S.sc.sd=document.getElementById('sd').value;
  S.sc.nt=document.getElementById('sn').value;
  S.name=document.getElementById('sname').value.trim();
  S.rate=parseFloat(document.getElementById('srate').value)||0;
  saveTimesGrid();
  save();
  try{tg?.sendData?.(JSON.stringify({type:'schedule_update',data:{startDate:S.sc.sd,startPhase:S.sc.sp,overrides:S.sc.ov,notifyTime:S.sc.nt,userName:S.name}}));}catch{}
  try{tg?.HapticFeedback?.notificationOccurred('success');}catch{}
  toast('✅ Настройки сохранены');
}
function resetAll(){if(!confirm('Сбросить все данные?'))return;localStorage.removeItem('wf4');S=def();rHome();toast('🗑️ Сброшено');}

// ═══════════ TOAST ═══════════
let _tt;
function toast(msg){let t=document.querySelector('.toast');if(!t){t=document.createElement('div');t.className='toast';document.body.appendChild(t);}t.textContent=msg;clearTimeout(_tt);_tt=setTimeout(()=>t?.remove(),2200);}

// ═══════════ MODALS ═══════════
document.getElementById('day-ov').addEventListener('click',e=>{if(e.target===e.currentTarget)closeDay();});
document.getElementById('sal-ov').addEventListener('click',e=>{if(e.target===e.currentTarget)closeSal();});

// ═══════════ INIT ═══════════
fillCats();
rHome();
</script>
</body>
</html>
